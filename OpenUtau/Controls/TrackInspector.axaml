<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="clr-namespace:OpenUtau.App.Controls"
             mc:Ignorable="d" d:DesignWidth="220" d:DesignHeight="320"
             x:Class="OpenUtau.App.Controls.TrackInspector">
  <UserControl.Styles>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource ForegroundBrushSecondary}"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*">
    <TextBlock Grid.Row="0" Classes="sectionTitle" Text="{DynamicResource tracks.tracksettings}"/>
    <!-- The full track header: singer, phonemizer, renderer, volume, pan, track settings and fx. -->
    <c:TrackHeader Grid.Row="1" Name="Header"/>
  </Grid>
</UserControl>
